{
  "package": {
    "productName": "Core Vault ER12A QA"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.corevault.er12a.qa",
      "targets": ["app"]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "title": "Core Vault ER12A QA",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
