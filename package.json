{
  "name": "core-vault-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A spatial, local-only Tauri interface for Bitcoin Core test networks",
  "type": "module",
  "scripts": {
    "asset:reactor": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python art-source/blender/core-reactor/build_core_reactor_v1.py",
    "dev": "vite --port 1420",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:regtest": "cargo test --manifest-path src-tauri/Cargo.toml --locked regtest::tests -- --include-ignored --test-threads=1",
    "verify": "npm run lint && npm test && npm run build && npm run test:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tauri-apps/api": "^1.6.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
